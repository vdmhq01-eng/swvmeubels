# Database
DATABASE_URL="postgresql://swv:swv@localhost:5432/swvmeubel?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="vervang-met-een-32-byte-secret"
SESSION_TIMEOUT_MINUTES="30"

# Exact Synergy
EXACT_BASE_URL="https://start.exactonline.nl/api/v1"
EXACT_CLIENT_ID=""
EXACT_CLIENT_SECRET=""
EXACT_DIVISION=""
EXACT_WEBHOOK_SECRET=""

# Cleverdesk
CLEVERDESK_BASE_URL="https://api.cleverdesk.nl/v1"
CLEVERDESK_API_KEY=""
CLEVERDESK_WEBHOOK_SECRET=""

# Storage / uploads
UPLOAD_MAX_BYTES="10485760"
UPLOAD_ALLOWED_MIME="application/pdf,image/jpeg,image/png"
SIGNED_URL_TTL_SECONDS="300"
STORAGE_DRIVER="local"
STORAGE_BUCKET="swv-documents"

# Security
RATE_LIMIT_LOGIN_PER_MIN="5"
RATE_LIMIT_UPLOAD_PER_MIN="20"
ENFORCE_2FA_ADMIN="true"
